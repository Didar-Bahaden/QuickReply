      replacement_content: "            <input\n              ref={searchInputRef}\n              type=\"text\"\n              placeholder=\"Search responses... (Cmd+K)\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-[42px] pr-10 py-3 rounded-xl border border-[#E5E7EB] dark:border-[#334155] bg-white dark:bg-[#1E293B] text-[15px] text-[#1F2937] dark:text-[#F3F4F6] outline-none focus:border-[#FF4D3D] focus:ring-[3px] focus:ring-[#FF4D3D]/10 transition-colors shadow-sm placeholder-[#9CA3AF] dark:placeholder-[#6B7280] font-[\'Nunito_Sans\',sans-serif]\"\n            />"
