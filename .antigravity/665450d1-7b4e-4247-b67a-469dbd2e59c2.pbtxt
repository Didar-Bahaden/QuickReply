      replacement_content: "  // Filter snippets based on Category + Search Term + Sort\n  const filteredSnippets = useMemo(() => {\n    let result = snippets.filter((snippet) => {\n      const matchesCategory = selectedCategory === \'All\' || snippet.category === selectedCategory;\n      const matchesSearch = \n        snippet.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        snippet.body.toLowerCase().includes(searchQuery.toLowerCase());\n      return matchesCategory && matchesSearch;\n    });\n\n    if (sortMode === \'used\') {\n      result = result.sort((a, b) => (b.useCount || 0) - (a.useCount || 0));\n    } else {\n      result = result.sort((a, b) => b.id - a.id); // Assuming newer ID is larger / recent\n    }\n\n    return result;\n  }, [snippets, selectedCategory, searchQuery, sortMode]);"
    }
