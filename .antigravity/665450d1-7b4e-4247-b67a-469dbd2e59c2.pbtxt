    replacement_chunks {
      target_content: "  // Copy to clipboard with success state\n  const handleCopyText = async (e: React.MouseEvent, id: number, text: string) => {\n    e.stopPropagation(); // Avoid expanding/collapsing on copy button tap\n    try {\n      await navigator.clipboard.writeText(text);\n      setCopiedSnippetId(id);\n      triggerToast(\'Copied to clipboard!\');\n      \n      // Reset card visual state\n      setTimeout(() => {\n        setCopiedSnippetId(null);\n      }, 1500);\n    } catch (err) {\n      triggerToast(\'Failed to copy text.\');\n    }\n  };"
      replacement_content: "  // Copy to clipboard with success state\n  const handleCopyText = async (e: React.MouseEvent, id: number, text: string) => {\n    e.stopPropagation(); // Avoid expanding/collapsing on copy button tap\n    \n    // Check for variables first {VariableName}\n    const regex = /\\{([a-zA-Z0-9_\\s-]+)\\}/g;\n    const matches = Array.from(text.matchAll(regex));\n    \n    if (matches.length > 0) {\n      // deduplicate variables\n      const vars = Array.from(new Set(matches.map(m => m[1])));\n      setPendingSnippetTask({ id, text, variables: vars });\n      setVariableValues({});\n      setIsVariableSheetOpen(true);\n      return;\n    }\n    \n    await executeCopy(id, text);\n  };\n\n  const executeCopy = async (id: number, finalString: string) => {\n    try {\n      await navigator.clipboard.writeText(finalString);\n      setCopiedSnippetId(id);\n      triggerToast(\'Copied to clipboard!\');\n      \n      // Update useCount\n      setSnippets(prev => prev.map(s => s.id === id ? { ...s, useCount: (s.useCount || 0) + 1 } : s));\n      \n      // Reset card visual state\n      setTimeout(() => {\n        setCopiedSnippetId(null);\n      }, 1500);\n    } catch (err) {\n      triggerToast(\'Failed to copy text.\');\n    }\n  };\n\n  const handleFinalVariableCopy = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!pendingSnippetTask) return;\n    \n    let finalString = pendingSnippetTask.text;\n    pendingSnippetTask.variables.forEach(v => {\n      // replace all instances of {variableName}\n      const val = variableValues[v] || \'{\' + v + \'}\';\n      const regex = new RegExp(`\\\\{${v}\\\\}`, \'g\');\n      finalString = finalString.replace(regex, val);\n    });\n    \n    executeCopy(pendingSnippetTask.id, finalString);\n    setIsVariableSheetOpen(false);\n  };"
    }
    replacement_chunks {
      target_content: "        {/* 6. BOTTOM SHEET BACKDROP */}\n        <div \n          onClick={() => setIsBottomSheetOpen(false)}\n          className={`absolute inset-0 bg-[#0F172A]/40 dark:bg-black/60 backdrop-blur-[2px] z-50 transition-opacity duration-300 ${isBottomSheetOpen ? \'opacity-100 pointer-events-auto\' : \'opacity-0 pointer-events-none\'}`}\n        />\n\n        {/* 7. BOTTOM SHEET ELEMENT */}"
      replacement_content: "        {/* 6. BOTTOM SHEET BACKDROP */}\n        <div \n          onClick={() => {\n            setIsBottomSheetOpen(false);\n            setIsVariableSheetOpen(false);\n          }}\n          className={`absolute inset-0 bg-[#0F172A]/40 dark:bg-black/60 backdrop-blur-[2px] z-50 transition-opacity duration-300 ${(isBottomSheetOpen || isVariableSheetOpen) ? \'opacity-100 pointer-events-auto\' : \'opacity-0 pointer-events-none\'}`}\n        />\n\n        {/* VARIABLES REPLACER BOTTOM SHEET */}\n        <div className={`absolute bottom-0 left-0 right-0 bg-white dark:bg-[#1E293B] rounded-t-3xl pt-2.5 px-5 pb-8 z-60 shadow-[0_-20px_40px_rgba(0,0,0,0.12)] flex flex-col max-h-[90vh] overflow-y-auto transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] ${isVariableSheetOpen ? \'translate-y-0\' : \'translate-y-full\'}`}>\n          <div \n            className=\"w-10 h-1.5 bg-[#E5E7EB] dark:bg-[#334155] rounded-full mx-auto mb-5 cursor-pointer hover:bg-gray-300 transition-colors\"\n            onClick={() => setIsVariableSheetOpen(false)} \n          />\n\n          <div className=\"flex justify-between items-center mb-5\">\n            <h2 className=\"text-xl font-extrabold text-[#1F2937] dark:text-[#F3F4F6] m-0\">\n              Fill Variables\n            </h2>\n            <button\n              onClick={() => setIsVariableSheetOpen(false)}\n              className=\"bg-[#F3F4F6] dark:bg-[#334155] w-8 h-8 rounded-full flex items-center justify-center text-[#4B5563] dark:text-[#D1D5DB]\"\n            >\n              <X weight=\"bold\" size={14} />\n            </button>\n          </div>\n\n          <form onSubmit={handleFinalVariableCopy} className=\"flex flex-col gap-4\">\n            {pendingSnippetTask?.variables.map(variable => (\n              <div key={variable} className=\"flex flex-col gap-1.5\">\n                <label className=\"text-[13px] font-bold text-[#4B5563] dark:text-[#D1D5DB]\">{variable}</label>\n                <input\n                  type=\"text\"\n                  required\n                  autoFocus\n                  placeholder={`Enter ${variable}...`}\n                  value={variableValues[variable] || \'\'}\n                  onChange={(e) => setVariableValues(prev => ({ ...prev, [variable]: e.target.value }))}\n                  className=\"w-full p-3.5 rounded-xl border border-[#E5E7EB] dark:border-[#334155] bg-white dark:bg-[#0F172A] text-[15px] text-[#1F2937] dark:text-[#F3F4F6] outline-none focus:border-[#FF4D3D] focus:ring-[3px] focus:ring-[#FF4D3D]/10 transition-colors shadow-sm font-[\'Nunito_Sans\',sans-serif]\"\n                />\n              </div>\n            ))}\n\n            <button\n              type=\"submit\"\n              className=\"mt-2 p-[14px] rounded-xl font-extrabold text-[15px] flex items-center justify-center gap-2 transition-all bg-[#FF4D3D] text-white shadow-[0_6px_16px_rgba(255,77,61,0.25)] hover:bg-[#E63E2E] active:scale-[0.98]\"\n            >\n              <Copy weight=\"bold\" size={18} />\n              Finalize & Copy\n            </button>\n          </form>\n        </div>\n\n        {/* 7. BOTTOM SHEET ELEMENT */}"
    }
