        }
        lines {
          text: "                <p className=\"text-sm text-[#6B7280] dark:text-[#9CA3AF] max-w-[250px] mx-auto font-[\'Nunito_Sans\',sans-serif]\">It seems you\'re offline. Please reconnect to sync and load your quick replies.</p>"
