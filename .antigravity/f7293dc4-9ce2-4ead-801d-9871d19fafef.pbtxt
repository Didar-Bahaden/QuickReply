          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  className=\"bg-[#FF4D3D] hover:bg-[#E63E2E] active:scale-95 text-white shadow-lg shadow-[#FF4D3D]/25 font-bold py-3 px-6 rounded-xl flex items-center gap-2 transition-all\""
