        }
        lines {
          text: "                  <WifiSlash weight=\"duotone\" size={64} />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <h3 className=\"text-xl font-extrabold text-[#1F2937] dark:text-[#F3F4F6] mb-2 tracking-tight\">Check Your Connection</h3>"
