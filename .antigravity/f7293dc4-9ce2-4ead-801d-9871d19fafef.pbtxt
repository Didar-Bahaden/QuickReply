      replacement_content: "            })\n          ) : isOffline ? (\n             <div className=\"flex flex-col items-center justify-center h-full text-center p-6 animate-[fadeIn_0.5s_ease-out]\">\n                <div className=\"w-32 h-32 mb-6 text-[#FF4D3D] opacity-90 mx-auto drop-shadow-[0_8px_16px_rgba(255,77,61,0.2)] flex items-center justify-center relative\">\n                  <div className=\"absolute inset-0 bg-[#FF4D3D]/10 rounded-full animate-ping opacity-20\"></div>\n                  <WifiSlash weight=\"duotone\" size={64} />\n                </div>\n                <h3 className=\"text-xl font-extrabold text-[#1F2937] dark:text-[#F3F4F6] mb-2 tracking-tight\">Check Your Connection</h3>\n                <p className=\"text-sm text-[#6B7280] dark:text-[#9CA3AF] max-w-[250px] mx-auto font-[\'Nunito_Sans\',sans-serif]\">It seems you\'re offline. Please reconnect to sync and load your quick replies.</p>\n             </div>\n          ) : snippets.length === 0 ? (\n             <div className=\"flex flex-col items-center justify-center h-full text-center p-6 animate-[fadeIn_0.5s_ease-out]\">\n                <div className=\"w-32 h-32 mb-6 bg-gradient-to-tr from-[#FF4D3D] to-[#FF8A7A] rounded-2xl rotate-3 shadow-xl shadow-[#FF4D3D]/20 mx-auto flex items-center justify-center text-white relative\">\n                  <div className=\"absolute -top-3 -right-3 bg-white dark:bg-[#1E293B] text-[#FF4D3D] rounded-full p-2 shadow-sm border border-gray-100 dark:border-gray-700\">\n                    <ChatTeardropText weight=\"duotone\" size={24} />\n                  </div>\n                  <span className=\"text-5xl font-black\">!</span>\n                </div>\n                <h3 className=\"text-2xl font-extrabold text-[#1F2937] dark:text-[#F3F4F6] mb-3 tracking-tight\">Add Your First Reply</h3>\n                <p className=\"text-sm text-[#6B7280] dark:text-[#9CA3AF] max-w-[250px] mx-auto font-[\'Nunito_Sans\',sans-serif] mb-6\">Create a new snippet to start saving time and answering faster.</p>\n                <button\n                  onClick={handleOpenAdd}\n                  className=\"bg-[#FF4D3D] hover:bg-[#E63E2E] active:scale-95 text-white shadow-lg shadow-[#FF4D3D]/25 font-bold py-3 px-6 rounded-xl flex items-center gap-2 transition-all\"\n                >\n                  <Plus weight=\"bold\" size={18} />\n                  New Snippet\n                </button>\n             </div>\n          ) : (\n            <div className=\"flex flex-col items-center justify-center h-[260px] text-[#6B7280] dark:text-[#9CA3AF] gap-3\">\n              <span className=\"text-[40px] opacity-70\">\n                 <MagnifyingGlass weight=\"duotone\" size={48} className=\"text-[#9CA3AF] dark:text-[#6B7280]\" />\n              </span>\n              <p className=\"m-0 font-bold text-[16px] text-[#1F2937] dark:text-[#F3F4F6]\">No matches found</p>\n              <p className=\"m-0 text-[14px] text-[#9CA3AF] dark:text-[#6B7280]\">Try adjusting your search criteria</p>\n            </div>\n          )}\n        </div>\n\n        {/* 4. TOAST NOTIFICATION */}"
