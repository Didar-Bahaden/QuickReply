    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport React, { useState, useEffect, useRef, useMemo } from \'react\';\n\ntype Snippet = {\n  id: number;\n  category: string;\n  title: string;\n  body: string;\n};\n\n// Preloaded sample snippets data\nconst INITIAL_SNIPPETS: Snippet[] = [\n  {\n    id: 1,\n    category: \'Shipping\',\n    title: \'Order Tracking Link\',\n    body: \'Hey there! \360\237\223\246 Your order is on its way. You can track its progress here: https://track.quickreply.io/order-status\'\n  },\n  {\n    id: 2,\n    category: \'Shipping\',\n    title: \'International Shipping Policy\',\n    body: \'Yes, we ship globally! \360\237\214\215 International delivery usually takes between 7 to 14 business days depending on customs.\'\n  },\n  {\n    id: 3,\n    category: \'Returns\',\n    title: \'30-Day Policy Details\',\n    body: \'We offer a 30-day return policy! \360\237\224\204 Items must be in their original packaging. Start your return at returns.quickreply.io\'\n  },\n  {\n    id: 4,\n    category: \'Returns\',\n    title: \'Damaged Items Procedure\',\n    body: \'I am so sorry to hear that! \360\237\245\272 Please share your order number along with a photo of the damaged item so we can ship a replacement.\'\n  },\n  {\n    id: 5,\n    category: \'Pricing\',\n    title: \'First Order Discount\',\n    body: \'Welcome aboard! \360\237\216\211 You can use the promo code \"WELCOME10\" at checkout to get an extra 10% discount on your first purchase.\'\n  },\n  {\n    id: 6,\n    category: \'Pricing\',\n    title: \'Bulk Pricing Inquiry\',\n    body: \'Thanks for reaching out! \360\237\222\274 We offer discounts for wholesale orders of 50 units or more. Please email wholesale@quickreply.io\'\n  },\n  {\n    id: 7,\n    category: \'General\',\n    title: \'Standard Business Hours\',\n    body: \'Our support hours are Mon-Fri, 9:00 AM to 5:00 PM EST. \360\237\225\222 We will do our absolute best to get back to you within 2 hours.\'\n  },\n  {\n    id: 8,\n    category: \'General\',\n    title: \'Closing Appreciation\',\n    body: \'Thank you for choosing us today! \360\237\231\214 Let me know if you need help with anything else. Have a fantastic rest of your day!\'\n  }\n];\n\nconst CATEGORIES = [\'All\', \'Shipping\', \'Returns\', \'Pricing\', \'General\'];\n\nexport default function QuickReply() {\n  const [snippets, setSnippets] = useState<Snippet[]>(INITIAL_SNIPPETS);\n  const [selectedCategory, setSelectedCategory] = useState(\'All\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  \n  // UI states\n  const [mounted, setMounted] = useState(false);\n  const [time, setTime] = useState(\'09:41\');\n  const [expandedCards, setExpandedCards] = useState<Set<number>>(new Set());\n  const [copiedSnippetId, setCopiedSnippetId] = useState<number | null>(null);\n  \n  // Bottom Sheet States\n  const [isBottomSheetOpen, setIsBottomSheetOpen] = useState(false);\n  const [editingSnippet, setEditingSnippet] = useState<Snippet | null>(null);\n  const [formTitle, setFormTitle] = useState(\'\');\n  const [formCategory, setFormCategory] = useState(\'General\');\n  const [formBody, setFormBody] = useState(\'\');\n  \n  // Toast Notification State\n  const [toast, setToast] = useState({ visible: false, message: \'\' });\n  const toastTimeoutRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Injects Google Fonts via link tag and updates simulated device clock\n  useEffect(() => {\n    setMounted(true);\n    \n    // Inject Fonts\n    const link = document.createElement(\'link\');\n    link.rel = \'stylesheet\';\n    link.href = \'https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap\';\n    document.head.appendChild(link);\n\n    // Update Simulated clock\n    const updateTime = () => {\n      const now = new Date();\n      const hours = String(now.getHours()).padStart(2, \'0\');\n      const minutes = String(now.getMinutes()).padStart(2, \'0\');\n      setTime(`${hours}:${minutes}`);\n    };\n    updateTime();\n    const clockInterval = setInterval(updateTime, 60000);\n\n    return () => {\n      document.head.removeChild(link);\n      clearInterval(clockInterval);\n      if (toastTimeoutRef.current) clearTimeout(toastTimeoutRef.current);\n    };\n  }, []);\n\n  // Filter snippets based on Category + Search Term\n  const filteredSnippets = useMemo(() => {\n    return snippets.filter((snippet) => {\n      const matchesCategory = selectedCategory === \'All\' || snippet.category === selectedCategory;\n      const matchesSearch = \n        snippet.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        snippet.body.toLowerCase().includes(searchQuery.toLowerCase());\n      return matchesCategory && matchesSearch;\n    });\n  }, [snippets, selectedCategory, searchQuery]);\n\n  // Compute item counts for the category tabs\n  const categoryCounts = useMemo(() => {\n    const counts: Record<string, number> = { All: snippets.length };\n    CATEGORIES.slice(1).forEach(cat => {\n      counts[cat] = snippets.filter(s => s.category === cat).length;\n    });\n    return counts;\n  }, [snippets]);\n\n  // Trigger Toast feedback\n  const triggerToast = (message: string) => {\n    if (toastTimeoutRef.current) clearTimeout(toastTimeoutRef.current);\n    setToast({ visible: true, message });\n    toastTimeoutRef.current = setTimeout(() => {\n      setToast({ visible: false, message: \'\' });\n    }, 2500);\n  };\n\n  // Expand or collapse card text body\n  const toggleCardExpansion = (id: number) => {\n    const next = new Set(expandedCards);\n    if (next.has(id)) {\n      next.delete(id);\n    } else {\n      next.add(id);\n    }\n    setExpandedCards(next);\n  };\n\n  // Copy to clipboard with success state\n  const handleCopyText = async (e: React.MouseEvent, id: number, text: string) => {\n    e.stopPropagation(); // Avoid expanding/collapsing on copy button tap\n    try {\n      await navigator.clipboard.writeText(text);\n      setCopiedSnippetId(id);\n      triggerToast(\'Copied to clipboard!\');\n      \n      // Reset card visual state\n      setTimeout(() => {\n        setCopiedSnippetId(null);\n      }, 1500);\n    } catch (err) {\n      triggerToast(\'Failed to copy text.\');\n    }\n  };\n\n  // Open bottom sheet for fresh layout\n  const handleOpenAdd = () => {\n    setEditingSnippet(null);\n    setFormTitle(\'\');\n    setFormCategory(\'General\');\n    setFormBody(\'\');\n    setIsBottomSheetOpen(true);\n  };\n\n  // Open bottom sheet populated with existing details\n  const handleOpenEdit = (e: React.MouseEvent, snippet: Snippet) => {\n    e.stopPropagation();\n    setEditingSnippet(snippet);\n    setFormTitle(snippet.title);\n    setFormCategory(snippet.category);\n    setFormBody(snippet.body);\n    setIsBottomSheetOpen(true);\n  };\n\n  // Handle Form Submission\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formTitle.trim() || !formBody.trim()) return;\n\n    if (editingSnippet) {\n      // Edit logic\n      setSnippets(prev => prev.map(s => s.id === editingSnippet.id ? {\n        ...s,\n        title: formTitle.trim(),\n        category: formCategory,\n        body: formBody.trim()\n      } : s));\n      triggerToast(\'Snippet updated successfully\');\n    } else {\n      // Add logic\n      const newSnippet: Snippet = {\n        id: Date.now(),\n        title: formTitle.trim(),\n        category: formCategory,\n        body: formBody.trim()\n      };\n      setSnippets(prev => [newSnippet, ...prev]);\n      triggerToast(\'New snippet saved\');\n    }\n    setIsBottomSheetOpen(false);\n  };\n\n  // Delete Action\n  const handleDelete = (e: React.MouseEvent, id: number) => {\n    e.stopPropagation();\n    setSnippets(prev => prev.filter(s => s.id !== id));\n    triggerToast(\'Snippet deleted\');\n  };\n\n  const getCategoryEmoji = (category: string) => {\n    switch (category) {\n      case \'Shipping\': return \'\360\237\223\246\';\n      case \'Returns\': return \'\360\237\224\204\';\n      case \'Pricing\': return \'\360\237\222\260\';\n      case \'General\': return \'\360\237\222\254\';\n      default: return \'\360\237\223\235\';\n    }\n  };\n\n  // Return SSR-friendly initial wrapper\n  if (!mounted) {\n    return (\n      <div style={{ display: \'flex\', justifyContent: \'center\', alignItems: \'center\', minHeight: \'100vh\', background: \'#e1e1e6\' }}>\n        <p style={{ fontFamily: \'sans-serif\', color: \'#6B7280\' }}>Loading QuickReply...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"app-viewport\">\n      <style dangerouslySetInnerHTML={{ __html: `\n        body {\n          margin: 0;\n          padding: 0;\n          background-color: #E2E8F0;\n          font-family: \'Nunito\', \'Nunito Sans\', sans-serif;\n          -webkit-tap-highlight-color: transparent;\n          display: flex;\n          justify-content: center;\n          align-items: center;\n          min-height: 100vh;\n        }\n\n        .app-viewport {\n          width: 100%;\n          max-width: 430px;\n          height: 100vh;\n          max-height: 932px; /* standard iPhone Pro Max aspect height */\n          background-color: #F7F7FB;\n          position: relative;\n          display: flex;\n          flex-direction: column;\n          overflow: hidden;\n          box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);\n        }\n\n        @media (max-width: 430px) {\n          .app-viewport {\n            max-height: 100vh;\n            border-radius: 0;\n            box-shadow: none;\n          }\n        }\n\n        /* Animations */\n        @keyframes slideUpIn {\n          from {\n            transform: translateY(24px);\n            opacity: 0;\n          }\n          to {\n            transform: translateY(0);\n            opacity: 1;\n          }\n        }\n\n        @keyframes pulseSuccess {\n          0% { background-color: #ffffff; }\n          30% { background-color: #ECFDF5; border-color: #34D399; }\n          100% { background-color: #ffffff; }\n        }\n\n        /* Scrollbar customization */\n        .no-scrollbar::-webkit-scrollbar {\n          display: none;\n        }\n        .no-scrollbar {\n          -ms-overflow-style: none;\n          scrollbar-width: none;\n        }\n\n        /* Focus states */\n        input:focus, textarea:focus, select:focus {\n          outline: none;\n          border-color: #FF4D3D !important;\n          box-shadow: 0 0 0 3px rgba(255, 77, 61, 0.1);\n        }\n      `}} />\n\n      {/* 1. MOCK PHONE STATUS BAR */}\n      <div style={{\n        display: \'flex\',\n        justifyContent: \'space-between\',\n        alignItems: \'center\',\n        padding: \'14px 24px 8px 24px\',\n        backgroundColor: \'#F7F7FB\',\n        userSelect: \'none\',\n        zIndex: 10\n      }}>\n        {/* Mock Time */}\n        <span style={{ fontSize: \'14px\', fontWeight: \'700\', color: \'#1F2937\', letterSpacing: \'-0.2px\' }}>\n          {time}\n        </span>\n        \n        {/* Mock Status Icons */}\n        <div style={{ display: \'flex\', alignItems: \'center\', gap: \'6px\' }}>\n          {/* Signal Indicator */}\n          <svg width=\"17\" height=\"11\" viewBox=\"0 0 17 11\" fill=\"none\">\n            <rect x=\"0.5\" y=\"8\" width=\"2.5\" height=\"3\" rx=\"0.5\" fill=\"#1F2937\" />\n            <rect x=\"4.5\" y=\"6\" width=\"2.5\" height=\"5\" rx=\"0.5\" fill=\"#1F2937\" />\n            <rect x=\"8.5\" y=\"3.5\" width=\"2.5\" height=\"7.5\" rx=\"0.5\" fill=\"#1F2937\" />\n            <rect x=\"12.5\" y=\"0.5\" width=\"2.5\" height=\"10.5\" rx=\"0.5\" fill=\"#1F2937\" />\n          </svg>\n          \n          {/* Wifi Indicator */}\n          <svg width=\"15\" height=\"11\" viewBox=\"0 0 15 11\" fill=\"none\">\n            <path d=\"M7.5 11C8.2 11 8.8 10.4 8.8 9.7C8.8 9 8.2 8.4 7.5 8.4C6.8 8.4 6.2 9 6.2 9.7C6.2 10.4 6.8 11 7.5 11Z\" fill=\"#1F2937\"/>\n            <path d=\"M10.8 6.4C8.9 4.6 6.1 4.6 4.2 6.4C3.8 6.8 3.2 6.8 2.8 6.4C2.4 6 2.4 5.4 2.8 5C5.4 2.4 9.6 2.4 12.2 5C12.6 5.4 12.6 6 12.2 6.4C11.8 6.8 11.2 6.8 10.8 6.4Z\" fill=\"#1F2937\"/>\n            <path d=\"M13.7 3.5C10.3 0.1 4.7 0.1 1.3 3.5C0.9 3.9 0.3 3.9 -0.1 3.5C-0.5 3.1 -0.5 2.5 -0.1 2.1C4.1 -2.1 10.9 -2.1 15.1 2.1C15.5 2.5 15.5 3.1 15.1 3.5C14.7 3.9 14.1 3.9 13.7 3.5Z\" fill=\"#1F2937\"/>\n          </svg>\n\n          {/* Battery Indicator */}\n          <div style={{\n            width: \'22px\',\n            height: \'11px\',\n            border: \'1px solid #1F2937\',\n            borderRadius: \'3px\',\n            padding: \'1px\',\n            display: \'flex\',\n            alignItems: \'center\',\n            position: \'relative\'\n          }}>\n            <div style={{ height: \'100%\', width: \'70%\', backgroundColor: \'#1F2937\', borderRadius: \'1.5px\' }} />\n            <div style={{\n              width: \'1.5px\',\n              height: \'4px\',\n              backgroundColor: \'#1F2937\',\n              borderRadius: \'0 1px 1px 0\',\n              position: \'absolute\',\n              right: \'-2.5px\',\n              top: \'2.5px\'\n            }} />\n          </div>\n        </div>\n      </div>\n\n      {/* 2. STICKY HEADER & SECTIONS */}\n      <div style={{\n        backgroundColor: \'#F7F7FB\',\n        borderBottom: \'1px solid #EEEDF2\',\n        zIndex: 5,\n        display: \'flex\',\n        flexDirection: \'column\',\n        gap: \'12px\',\n        padding: \'8px 16px 14px 16px\'\n      }}>\n        {/* Brand Header */}\n        <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\' }}>\n          <h1 style={{\n            fontSize: \'24px\',\n            fontWeight: \'800\',\n            color: \'#1F2937\',\n            margin: 0,\n            fontFamily: \'Nunito, sans-serif\'\n          }}>\n            Quick<span style={{ color: \'#FF4D3D\' }}>Reply</span>\n          </h1>\n        </div>\n\n        {/* Modern Search Input Container */}\n        <div style={{ position: \'relative\' }}>\n          <span style={{\n            position: \'absolute\',\n            left: \'14px\',\n            top: \'50%\',\n            transform: \'translateY(-50%)\',\n            display: \'flex\',\n            alignItems: \'center\',\n            color: \'#9CA3AF\'\n          }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n              <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>\n            </svg>\n          </span>\n          <input\n            type=\"text\"\n            placeholder=\"Search responses...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            style={{\n              width: \'100%\',\n              padding: \'11px 16px 11px 42px\',\n              borderRadius: \'12px\',\n              border: \'1px solid #E5E7EB\',\n              backgroundColor: \'#FFFFFF\',\n              fontSize: \'15px\',\n              fontFamily: \'inherit\',\n              color: \'#1F2937\',\n              boxSizing: \'border-box\',\n              transition: \'border-color 0.2s, box-shadow 0.2s\'\n            }}\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              style={{\n                position: \'absolute\',\n                right: \'12px\',\n                top: \'50%\',\n                transform: \'translateY(-50%)\',\n                background: \'none\',\n                border: \'none\',\n                cursor: \'pointer\',\n                color: \'#9CA3AF\',\n                padding: \'4px\'\n              }}\n            >\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n                <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n              </svg>\n            </button>\n          )}\n        </div>\n\n        {/* Scrollable Categories Row */}\n        <div \n          className=\"no-scrollbar\"\n          style={{\n            display: \'flex\',\n            gap: \'8px\',\n            overflowX: \'auto\',\n            padding: \'2px 0px\',\n            margin: \'0 -16px\',\n            paddingLeft: \'16px\',\n            paddingRight: \'16px\',\n          }}\n        >\n          {CATEGORIES.map((category) => {\n            const isActive = selectedCategory === category;\n            return (\n              <button\n                key={category}\n                onClick={() => setSelectedCategory(category)}\n                style={{\n                  display: \'flex\',\n                  alignItems: \'center\',\n                  gap: \'6px\',\n                  whiteSpace: \'nowrap\',\n                  padding: \'8px 14px\',\n                  borderRadius: \'100px\',\n                  border: \'none\',\n                  backgroundColor: isActive ? \'#FF4D3D\' : \'#FFFFFF\',\n                  color: isActive ? \'#FFFFFF\' : \'#4B5563\',\n                  fontWeight: \'700\',\n                  fontSize: \'14px\',\n                  cursor: \'pointer\',\n                  transition: \'background-color 0.2s, color 0.2s\',\n                  boxShadow: \'0 2px 4px rgba(0, 0, 0, 0.02)\',\n                  flexShrink: 0\n                }}\n              >\n                {category}\n                <span style={{\n                  fontSize: \'11px\',\n                  padding: \'2px 6px\',\n                  borderRadius: \'100px\',\n                  backgroundColor: isActive ? \'rgba(255,255,255,0.25)\' : \'#F3F4F6\',\n                  color: isActive ? \'#FFFFFF\' : \'#6B7280\',\n                  fontWeight: \'700\',\n                  minWidth: \'14px\',\n                  textAlign: \'center\'\n                }}>\n                  {categoryCounts[category] || 0}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 3. SCROLLABLE SNIPPETS LIST */}\n      <div \n        className=\"no-scrollbar\"\n        style={{\n          flex: 1,\n          overflowY: \'auto\',\n          padding: \'16px\',\n          display: \'flex\',\n          flexDirection: \'column\',\n          gap: \'12px\',\n          paddingBottom: \'90px\' // spacing to make sure FAB doesn\'t overlay essential action item buttons\n        }}\n      >\n        {filteredSnippets.length > 0 ? (\n          filteredSnippets.map((snippet, index) => {\n            const isExpanded = expandedCards.has(snippet.id);\n            const isCopied = copiedSnippetId === snippet.id;\n            \n            return (\n              <div\n                key={snippet.id}\n                onClick={() => toggleCardExpansion(snippet.id)}\n                style={{\n                  backgroundColor: \'#FFFFFF\',\n                  borderRadius: \'16px\',\n                  border: \'1.5px solid #F1F1F5\',\n                  padding: \'16px\',\n                  boxShadow: \'0 4px 12px rgba(117, 127, 233, 0.03)\',\n                  cursor: \'pointer\',\n                  animation: `slideUpIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards`,\n                  animationDelay: `${index * 0.06}s`,\n                  opacity: 0, // setup for staggered load animation\n                  animationFillMode: \'forwards\',\n                  transition: \'border-color 0.2s, box-shadow 0.2s\',\n                  userSelect: \'none\',\n                  ...(isCopied && {\n                    animation: \'pulseSuccess 1.4s ease-out forwards\',\n                  })\n                }}\n              >\n                {/* Header Row */}\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'8px\' }}>\n                  <div style={{ display: \'flex\', alignItems: \'center\', gap: \'8px\' }}>\n                    <span style={{ fontSize: \'18px\' }}>\n                      {getCategoryEmoji(snippet.category)}\n                    </span>\n                    <h3 style={{\n                      fontSize: \'16px\',\n                      fontWeight: \'700\',\n                      color: \'#1F2937\',\n                      margin: 0,\n                      lineHeight: \'1.2\'\n                    }}>\n                      {snippet.title}\n                    </h3>\n                  </div>\n                  <span style={{\n                    fontSize: \'11px\',\n                    fontWeight: \'700\',\n                    backgroundColor: \'rgba(255, 77, 61, 0.08)\',\n                    color: \'#FF4D3D\',\n                    padding: \'4px 8px\',\n                    borderRadius: \'100px\',\n                    letterSpacing: \'0.3px\',\n                    textTransform: \'uppercase\'\n                  }}>\n                    {snippet.category}\n                  </span>\n                </div>\n\n                {/* Content body with Expand Trigger */}\n                <div style={{ marginBottom: \'14px\', position: \'relative\' }}>\n                  <p style={{\n                    fontSize: \'14px\',\n                    lineHeight: \'1.5\',\n                    color: \'#4B5563\',\n                    margin: 0,\n                    wordBreak: \'break-word\',\n                    fontFamily: \'\"Nunito Sans\", sans-serif\'\n                  }}>\n                    {isExpanded \n                      ? snippet.body \n                      : (snippet.body.length > 72 \n                          ? `${snippet.body.slice(0, 72)}...` \n                          : snippet.body)\n                    }\n                  </p>\n                  {snippet.body.length > 72 && !isExpanded && (\n                    <span style={{\n                      display: \'inline-block\',\n                      color: \'#9CA3AF\',\n                      fontSize: \'12px\',\n                      fontWeight: \'600\',\n                      marginTop: \'4px\'\n                    }}>\n                      Tap to expand\n                    </span>\n                  )}\n                </div>\n\n                {/* Card Action Buttons Row */}\n                <div style={{\n                  display: \'flex\',\n                  justifyContent: \'space-between\',\n                  alignItems: \'center\',\n                  borderTop: \'1px solid #F3F4F6\',\n                  paddingTop: \'12px\'\n                }}>\n                  <div style={{ display: \'flex\', gap: \'4px\' }}>\n                    {/* Edit button */}\n                    <button\n                      onClick={(e) => handleOpenEdit(e, snippet)}\n                      style={{\n                        padding: \'6px 12px\',\n                        backgroundColor: \'transparent\',\n                        border: \'none\',\n                        color: \'#4B5563\',\n                        fontSize: \'13px\',\n                        fontWeight: \'700\',\n                        borderRadius: \'8px\',\n                        cursor: \'pointer\',\n                        display: \'flex\',\n                        alignItems: \'center\',\n                        gap: \'4px\'\n                      }}\n                    >\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                        <path d=\"M12 20h9\"></path>\n                        <path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"></path>\n                      </svg>\n                      Edit\n                    </button>\n\n                    {/* Delete button */}\n                    <button\n                      onClick={(e) => handleDelete(e, snippet.id)}\n                      style={{\n                        padding: \'6px 12px\',\n                        backgroundColor: \'transparent\',\n                        border: \'none\',\n                        color: \'#FF4D3D\',\n                        fontSize: \'13px\',\n                        fontWeight: \'700\',\n                        borderRadius: \'8px\',\n                        cursor: \'pointer\',\n                        display: \'flex\',\n                        alignItems: \'center\',\n                        gap: \'4px\'\n                      }}\n                    >\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                      Delete\n                    </button>\n                  </div>\n\n                  {/* Copy Button */}\n                  <button\n                    onClick={(e) => handleCopyText(e, snippet.id, snippet.body)}\n                    style={{\n                      padding: \'7px 14px\',\n                      backgroundColor: isCopied ? \'#10B981\' : \'#FF4D3D\',\n                      border: \'none\',\n                      color: \'#FFFFFF\',\n                      fontSize: \'13px\',\n                      fontWeight: \'700\',\n                      borderRadius: \'100px\',\n                      cursor: \'pointer\',\n                      display: \'flex\',\n                      alignItems: \'center\',\n                      gap: \'4px\',\n                      boxShadow: isCopied \n                        ? \'0 4px 10px rgba(16, 185, 129, 0.2)\' \n                        : \'0 4px 10px rgba(255, 77, 61, 0.2)\',\n                      transition: \'background-color 0.25s, transform 0.1s active\'\n                    }}\n                  >\n                    {isCopied ? (\n                      <>\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                          <polyline points=\"20 6 9 17 4 12\"></polyline>\n                        </svg>\n                        Copied\n                      </>\n                    ) : (\n                      <>\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                          <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                          <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                        </svg>\n                        Copy\n                      </>\n                    )}\n                  </button>\n                </div>\n              </div>\n            );\n          })\n        ) : (\n          <div style={{\n            display: \'flex\',\n            flexDirection: \'column\',\n            alignItems: \'center\',\n            justifyContent: \'center\',\n            height: \'220px\',\n            color: \'#6B7280\',\n            gap: \'8px\'\n          }}>\n            <span style={{ fontSize: \'32px\' }}>\360\237\224\215</span>\n            <p style={{ margin: 0, fontWeight: \'700\', fontSize: \'15px\' }}>No matches found</p>\n            <p style={{ margin: 0, fontSize: \'13px\', color: \'#9CA3AF\' }}>Try adjusting your search criteria</p>\n          </div>\n        )}\n      </div>\n\n      {/* 4. TOAST NOTIFICATION (Positional anchor right above FAB) */}\n      <div style={{\n        position: \'absolute\',\n        bottom: \'96px\',\n        left: \'16px\',\n        right: \'16px\',\n        backgroundColor: \'#1F2937\',\n        color: \'#FFFFFF\',\n        borderRadius: \'12px\',\n        padding: \'12px 16px\',\n        boxShadow: \'0 8px 24px rgba(0, 0, 0, 0.2)\',\n        display: \'flex\',\n        alignItems: \'center\',\n        gap: \'10px\',\n        zIndex: 40,\n        pointerEvents: \'none\',\n        transform: toast.visible ? \'translateY(0)\' : \'translateY(40px)\',\n        opacity: toast.visible ? 1 : 0,\n        transition: \'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease\'\n      }}>\n        <div style={{\n          width: \'6px\',\n          height: \'6px\',\n          borderRadius: \'50%\',\n          backgroundColor: \'#FF4D3D\'\n        }} />\n        <span style={{ fontSize: \'13px\', fontWeight: \'700\' }}>\n          {toast.message}\n        </span>\n      </div>\n\n      {/* 5. FLOATING ACTION BUTTON (FAB) */}\n      <button\n        onClick={handleOpenAdd}\n        style={{\n          position: \'absolute\',\n          bottom: \'24px\',\n          right: \'24px\',\n          width: \'56px\',\n          height: \'56px\',\n          borderRadius: \'50%\',\n          backgroundColor: \'#FF4D3D\',\n          border: \'none\',\n          color: \'#FFFFFF\',\n          display: \'flex\',\n          alignItems: \'center\',\n          justifyContent: \'center\',\n          boxShadow: \'0 8px 18px rgba(255, 77, 61, 0.35)\',\n          cursor: \'pointer\',\n          zIndex: 30,\n          transition: \'transform 0.15s ease\'\n        }}\n        onMouseDown={(e) => e.currentTarget.style.transform = \'scale(0.92)\'}\n        onMouseUp={(e) => e.currentTarget.style.transform = \'scale(1)\'}\n        onTouchStart={(e) => e.currentTarget.style.transform = \'scale(0.92)\'}\n        onTouchEnd={(e) => e.currentTarget.style.transform = \'scale(1)\'}\n      >\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n          <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n          <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n        </svg>\n      </button>\n\n      {/* 6. BOTTOM SHEET BACKDROP & OVERLAY */}\n      <div \n        onClick={() => setIsBottomSheetOpen(false)}\n        style={{\n          position: \'absolute\',\n          top: 0,\n          left: 0,\n          right: 0,\n          bottom: 0,\n          backgroundColor: \'rgba(15, 23, 42, 0.45)\',\n          backdropFilter: \'blur(3px)\',\n          zIndex: 50,\n          pointerEvents: isBottomSheetOpen ? \'auto\' : \'none\',\n          opacity: isBottomSheetOpen ? 1 : 0,\n          transition: \'opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1)\'\n        }}\n      />\n\n      {/* 7. BOTTOM SHEET ELEMENT */}\n      <div style={{\n        position: \'absolute\',\n        bottom: 0,\n        left: 0,\n        right: 0,\n        backgroundColor: \'#FFFFFF\',\n        borderTopLeftRadius: \'24px\',\n        borderTopRightRadius: \'24px\',\n        padding: \'8px 20px 24px 20px\',\n        zIndex: 60,\n        boxShadow: \'0 -10px 30px rgba(0, 0, 0, 0.08)\',\n        transform: isBottomSheetOpen ? \'translateY(0)\' : \'translateY(100%)\',\n        transition: \'transform 0.32s cubic-bezier(0.16, 1, 0.3, 1)\',\n        display: \'flex\',\n        flexDirection: \'column\'\n      }}>\n        {/* Top Drag Handle Bar */}\n        <div style={{\n          width: \'36px\',\n          height: \'5px\',\n          backgroundColor: \'#E5E7EB\',\n          borderRadius: \'100px\',\n          margin: \'0 auto 16px auto\',\n          cursor: \'pointer\'\n        }} onClick={() => setIsBottomSheetOpen(false)} />\n\n        <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'18px\' }}>\n          <h2 style={{\n            fontSize: \'18px\',\n            fontWeight: \'800\',\n            color: \'#1F2937\',\n            margin: 0\n          }}>\n            {editingSnippet ? \'Edit Snippet\' : \'New Snippet\'}\n          </h2>\n          <button\n            onClick={() => setIsBottomSheetOpen(false)}\n            style={{\n              background: \'#F3F4F6\',\n              border: \'none\',\n              borderRadius: \'50%\',\n              width: \'28px\',\n              height: \'28px\',\n              display: \'flex\',\n              alignItems: \'center\',\n              justifyContent: \'center\',\n              cursor: \'pointer\',\n              color: \'#4B5563\'\n            }}\n          >\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n              <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n            </svg>\n          </button>\n        </div>\n\n        <form onSubmit={handleSave} style={{ display: \'flex\', flexDirection: \'column\', gap: \'14px\' }}>\n          {/* Title Input */}\n          <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'6px\' }}>\n            <label style={{ fontSize: \'13px\', fontWeight: \'700\', color: \'#4B5563\' }}>Snippet Title</label>\n            <input\n              type=\"text\"\n              required\n              placeholder=\"e.g. Return Policy Overview\"\n              value={formTitle}\n              onChange={(e) => setFormTitle(e.target.value)}\n              style={{\n                padding: \'12px\',\n                borderRadius: \'12px\',\n                border: \'1.5px solid #E5E7EB\',\n                fontSize: \'15px\',\n                fontFamily: \'inherit\',\n                color: \'#1F2937\',\n                width: \'100%\',\n                boxSizing: \'border-box\'\n              }}\n            />\n          </div>\n\n          {/* Category Selector Pills inside form */}\n          <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'8px\' }}>\n            <label style={{ fontSize: \'13px\', fontWeight: \'700\', color: \'#4B5563\' }}>Category</label>\n            <div style={{ display: \'flex\', gap: \'8px\', flexWrap: \'wrap\' }}>\n              {CATEGORIES.slice(1).map((category) => {\n                const isSelected = formCategory === category;\n                return (\n                  <button\n                    key={category}\n                    type=\"button\"\n                    onClick={() => setFormCategory(category)}\n                    style={{\n                      padding: \'8px 14px\',\n                      borderRadius: \'100px\',\n                      border: \'1.5px solid\',\n                      borderColor: isSelected ? \'#FF4D3D\' : \'#E5E7EB\',\n                      backgroundColor: isSelected ? \'#FF4D3D\' : \'transparent\',\n                      color: isSelected ? \'#FFFFFF\' : \'#4B5563\',\n                      fontWeight: \'700\',\n                      fontSize: \'13px\',\n                      cursor: \'pointer\',\n                      transition: \'all 0.15s ease\'\n                    }}\n                  >\n                    {getCategoryEmoji(category)} {category}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Body Textarea */}\n          <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'6px\' }}>\n            <label style={{ fontSize: \'13px\', fontWeight: \'700\', color: \'#4B5563\' }}>Message Text</label>\n            <textarea\n              required\n              rows={4}\n              placeholder=\"Paste or write the response sent to customers...\"\n              value={formBody}\n              onChange={(e) => setFormBody(e.target.value)}\n              style={{\n                padding: \'12px\',\n                borderRadius: \'12px\',\n                border: \'1.5px solid #E5E7EB\',\n                fontSize: \'15px\',\n                fontFamily: \'inherit\',\n                color: \'#1F2937\',\n                width: \'100%\',\n                boxSizing: \'border-box\',\n                resize: \'none\',\n                lineHeight: \'1.4\'\n              }}\n            />\n          </div>\n\n          {/* Save Action Button */}\n          <button\n            type=\"submit\"\n            disabled={!formTitle.trim() || !formBody.trim()}\n            style={{\n              marginTop: \'8px\',\n              padding: \'14px\',\n              borderRadius: \'14px\',\n              border: \'none\',\n              backgroundColor: (!formTitle.trim() || !formBody.trim()) ? \'#F3F4F6\' : \'#FF4D3D\',\n              color: (!formTitle.trim() || !formBody.trim()) ? \'#9CA3AF\' : \'#FFFFFF\',\n              fontWeight: \'800\',\n              fontSize: \'15px\',\n              cursor: (!formTitle.trim() || !formBody.trim()) ? \'not-allowed\' : \'pointer\',\n              display: \'flex\',\n              alignItems: \'center\',\n              justifyContent: \'center\',\n              gap: \'6px\',\n              boxShadow: (!formTitle.trim() || !formBody.trim()) ? \'none\' : \'0 6px 16px rgba(255, 77, 61, 0.25)\',\n              transition: \'background-color 0.2s, color 0.2s\'\n            }}\n          >\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <polyline points=\"20 6 9 17 4 12\"></polyline>\n            </svg>\n            Save Snippet\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}"
