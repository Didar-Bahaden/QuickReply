      target_content: "  const [snippets, setSnippets] = useState<Snippet[]>(INITIAL_SNIPPETS);\n  const [categories, setCategories] = useState(INITIAL_CATEGORIES);\n  const [selectedCategory, setSelectedCategory] = useState(\'All\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  \n  // Bottom Sheet State for Add/Edit\n  const [isBottomSheetOpen, setIsBottomSheetOpen] = useState(false);\n  const [editingSnippet, setEditingSnippet] = useState<Snippet | null>(null);\n  const [formTitle, setFormTitle] = useState(\'\');\n  const [formCategory, setFormCategory] = useState(\'General\');\n  const [formBody, setFormBody] = useState(\'\');\n  \n  const [isSettingsOpen, setIsSettingsOpen] = useState(false);\n  const [isCategoryManagerOpen, setIsCategoryManagerOpen] = useState(false);\n  \n  // Category Manager State\n  const [editingCategory, setEditingCategory] = useState<string | null>(null);\n  const [editCategoryName, setEditCategoryName] = useState(\'\');\n  const [editCategoryEmoji, setEditCategoryEmoji] = useState(\'\360\237\217\267\357\270\217\');\n  \n  // Toast Notification State\n  const [toast, setToast] = useState({ visible: false, message: \'\' });\n  const toastTimeoutRef = useRef<NodeJS.Timeout | null>(null);"
      replacement_content: "  const [snippets, setSnippets] = useState<Snippet[]>([]);\n  const [categories, setCategories] = useState<{name: string, emoji: string}[]>([]);\n  const [selectedCategory, setSelectedCategory] = useState(\'All\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  \n  // Bottom Sheet State for Add/Edit\n  const [isBottomSheetOpen, setIsBottomSheetOpen] = useState(false);\n  const [editingSnippet, setEditingSnippet] = useState<Snippet | null>(null);\n  const [formTitle, setFormTitle] = useState(\'\');\n  const [formCategory, setFormCategory] = useState(\'General\');\n  const [formBody, setFormBody] = useState(\'\');\n  \n  const [isSettingsOpen, setIsSettingsOpen] = useState(false);\n  const [isCategoryManagerOpen, setIsCategoryManagerOpen] = useState(false);\n  \n  // Category Manager State\n  const [editingCategory, setEditingCategory] = useState<string | null>(null);\n  const [editCategoryName, setEditCategoryName] = useState(\'\');\n  const [editCategoryEmoji, setEditCategoryEmoji] = useState(\'\360\237\217\267\357\270\217\');\n  \n  // Toast Notification State\n  const [toast, setToast] = useState({ visible: false, message: \'\' });\n  const toastTimeoutRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Load from local storage on mount\n  useEffect(() => {\n    const savedSnippets = localStorage.getItem(\'quickreply_snippets\');\n    const savedCategories = localStorage.getItem(\'quickreply_categories\');\n    \n    if (savedSnippets) setSnippets(JSON.parse(savedSnippets));\n    else setSnippets(INITIAL_SNIPPETS);\n    \n    if (savedCategories) setCategories(JSON.parse(savedCategories));\n    else setCategories(INITIAL_CATEGORIES);\n  }, []);\n\n  // Save to local storage on change\n  useEffect(() => {\n    if (!mounted) return;\n    localStorage.setItem(\'quickreply_snippets\', JSON.stringify(snippets));\n  }, [snippets, mounted]);\n\n  useEffect(() => {\n    if (!mounted) return;\n    localStorage.setItem(\'quickreply_categories\', JSON.stringify(categories));\n  }, [categories, mounted]);"
    }
    instruction: "Implement local storage persistence for snippets and categories so data is saved securely on the user\'s device."
  }
}
