        }
        lines {
          text: "                <div className=\"w-32 h-32 mb-6 bg-gradient-to-tr from-[#FF4D3D] to-[#FF8A7A] rounded-2xl rotate-3 shadow-xl shadow-[#FF4D3D]/20 mx-auto flex items-center justify-center text-white relative\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <div className=\"absolute -top-3 -right-3 bg-white dark:bg-[#1E293B] text-[#FF4D3D] rounded-full p-2 shadow-sm border border-gray-100 dark:border-gray-700\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
