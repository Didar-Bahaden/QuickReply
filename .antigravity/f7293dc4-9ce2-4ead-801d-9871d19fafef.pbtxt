          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <p className=\"text-sm text-[#6B7280] dark:text-[#9CA3AF] max-w-[250px] mx-auto font-[\'Nunito_Sans\',sans-serif] mb-6\">Create a new snippet to start saving time and answering faster.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
